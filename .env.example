# Local examples only. FastAPI does not load this file automatically.
# Docker Compose reads .env for substitution; local CLI needs exported variables.
DATABASE_PATH=data/payments.db
API_KEY=
REQUIRE_API_KEY=false
SETTLEMENT_GRACE_HOURS=24
DB_TIMEOUT_MS=5000
PORT=8000
# Public deployment: generate a secret, set API_KEY and REQUIRE_API_KEY=true.
